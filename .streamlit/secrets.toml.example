# Copy these into Streamlit Cloud → App settings → Secrets
# Never commit a real secrets.toml with your API keys.

MISTRAL_API_KEY = "your_mistral_key_here"
GEMINI_API_KEY = "your_gemini_key_here"

# Use "tiny" or "base" on Streamlit Cloud free tier (less RAM).
# Locally you can use "small" for better accuracy.
WHISPER_MODEL = "base"
